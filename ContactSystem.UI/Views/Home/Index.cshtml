@{
    ViewData["Title"] = "Home Page";
}

@model ContactSystem.UI.Models.ContactSearchViewModel

<div class="search-form">
    <form asp-action="Index" method="get" class="form-inline">
        <div class="form-group">
            <label for="officeId">Office</label>
            <select id="officeId" name="OfficeId" class="form-control">
                @foreach (var office in Model.Offices)
                {
                    <option value="@office.Id" selected="@(office.Id == Model.OfficeId)">
                        @office.Name
                    </option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="searchTerm">Search</label>
            <input type="text" id="searchTerm" name="SearchTerm" class="form-control" value="@Model.SearchTerm" />
        </div>

        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

<hr />

<div class="contact-list">
    <table class="table table-striped table-hover">
        <tr>
            <th>#</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
        </tr>
        @for (int i = 0; i < Model.Contacts.Count; i++)
        {
            var index = i;

            if(Model.PageNumber > 1)
            {
                index += Model.PageSize * (Model.PageNumber - 1);
            }

            <tr>
                <td>@(index + 1)</td>   
                <td>@Model.Contacts[i].FirstName</td>
                <td>@Model.Contacts[i].LastName</td>
                <td>@Model.Contacts[i].Email</td>
            </tr>
        }
    </table>
</div>

<div class="pagination d-flex flex-column">
    <nav>
        <ul class="pagination">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-OfficeId="@Model.OfficeId" asp-route-SearchTerm="@Model.SearchTerm" asp-route-Page="@(Model.PageNumber - 1)">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-OfficeId="@Model.OfficeId" asp-route-SearchTerm="@Model.SearchTerm" asp-route-Page="@i">@i</a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-OfficeId="@Model.OfficeId" asp-route-SearchTerm="@Model.SearchTerm" asp-route-Page="@(Model.PageNumber + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
</div>
